# =============================================================
# .env.example — copy this file to ".env" and fill in real values:
#
#     cp .env.example .env
#
# The real ".env" must NEVER be committed to git (it's in .gitignore).
# This example file IS safe to commit — it contains no secrets.
# =============================================================

# --- Django core ---------------------------------------------
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-random-secret-key

# True in development only! Set DEBUG=False in production.
DEBUG=True

# Comma-separated, no spaces around entries
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (your setup: PostgreSQL 18, user omar) ----------
POSTGRES_USER=omar
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=job_board
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# If you use django-environ / python-decouple with DATABASE_URL,
# it can be built from the values above instead of being listed twice.
# Example for local dev:
# DATABASE_URL=postgres://omar:replace-me@localhost:5432/job_board
